#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

npm test

# ── git-secrets: prevent accidental commit of credentials ──────────────────
if command -v git-secrets > /dev/null 2>&1; then
  git diff --cached --name-only -z | xargs -0 git secrets --scan
  SECRETS_EXIT_CODE=$?
  if [ $SECRETS_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "[SECURITY] git-secrets detected potential credentials in staged files."
    echo "If false positive, add an exception with:"
    echo "  git secrets --add --global 'your-pattern'"
    exit 1
  fi
fi
