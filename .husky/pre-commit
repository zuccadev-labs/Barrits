#!/usr/bin/env sh
# Pre-commit quality gate for the barrits monorepo.
#
# Installed by `npm run prepare` (scripts/prepare-hooks.mjs sets `git config core.hooksPath .husky`),
# so it works without the husky runtime or lint-staged. It runs the same gates as CI on the whole
# SDK: lint, typecheck and the test suite. Skip deliberately with `git commit --no-verify` only for
# work-in-progress commits that will be amended before pushing.
set -e

npm run lint
npm run typecheck
npm test

# ── gitleaks: block staged credentials (only when installed; CI scans the whole history anyway) ─────
if command -v gitleaks > /dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --redact --no-banner --gitleaks-ignore-path .gitleaksignore; then
    echo ""
    echo "[SECURITY] gitleaks detected potential credentials in staged files."
    echo "If it is a reviewed false positive, add its fingerprint to .gitleaksignore."
    exit 1
  fi
fi
