{
  "name": "examples-bundlers",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vite": "node ../../../../../node_modules/vite/bin/vite.js build --config ./vite/vite.config.ts",
    "build:esbuild": "node ./esbuild/esbuild.config.mjs",
    "build:rollup": "node ../../../../../node_modules/rollup/dist/bin/rollup -c ./rollup/rollup.config.mjs",
    "build:webpack": "node ../../../../../node_modules/webpack/bin/webpack.js --config ./webpack/webpack.config.mjs",
    "build:all": "npm run build:vite && npm run build:esbuild && npm run build:rollup && npm run build:webpack"
  },
  "dependencies": {
    "barrits": "file:../.."
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "esbuild": "^0.25.3",
    "rollup": "^4.40.0",
    "vite": "^8.0.8",
    "webpack": "^5.99.0",
    "webpack-cli": "^6.0.1"
  }
}