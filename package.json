{
  "name": "barrits-monorepo",
  "version": "0.3.1",
  "description": "Monorepo for barrits SDKs, examples and open-source development tooling.",
  "license": "MIT",
  "author": "David Euclides Zuccarini Barrueta (devzucca / zuccadev)",
  "homepage": "https://github.com/zuccadev-labs/Barrits",
  "bugs": {
    "url": "https://github.com/zuccadev-labs/Barrits/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zuccadev-labs/Barrits.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk/*",
    "packages/sdk/*/examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @zuccadev-labs/barrits",
    "test": "npm run test --workspace @zuccadev-labs/barrits",
    "test:coverage": "npm run test:coverage --workspace @zuccadev-labs/barrits",
    "typecheck": "npm run typecheck --workspace @zuccadev-labs/barrits",
    "lint": "eslint packages/sdk/ts_js/src packages/sdk/ts_js/adapters",
    "lint:fix": "eslint packages/sdk/ts_js/src packages/sdk/ts_js/adapters --fix",
    "format": "prettier --check packages/sdk/ts_js/src packages/sdk/ts_js/adapters packages/sdk/ts_js/tests",
    "benchmark:algorithms": "npm run benchmark:algorithms --workspace @zuccadev-labs/barrits",
    "publish:jsr:dry-run": "npm run publish:jsr:dry-run --workspace @zuccadev-labs/barrits",
    "barrits:dev": "npm run barrits:dev --workspace @zuccadev-labs/barrits",
    "barrits:build": "npm run barrits:build --workspace @zuccadev-labs/barrits",
    "prepare": "node scripts/prepare-hooks.mjs",
    "format:write": "prettier --write packages/sdk/ts_js/src packages/sdk/ts_js/adapters packages/sdk/ts_js/tests"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "rollup": "^4.68.2",
    "vite": "^8.3.7",
    "vite-plugin-solid": "^2.11.16",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "qs": "^6.17.1",
    "tsup": {
      "esbuild": "^0.28.2"
    },
    "bundle-require": {
      "esbuild": "^0.28.2"
    },
    "vite": "^8.3.7",
    "glob": "^14.0.2",
    "minimatch": "^11.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.6.2"
}
